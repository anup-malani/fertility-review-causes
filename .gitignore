# OS files
.DS_Store

# Per-session/machine config
.mcp.json
.claude/

# API credentials. Scripts read these from the environment (OPENALEX_API_KEY, S2_API_KEY);
# .env holds them for local runs and must never be committed.
.env
.env.*
!.env.example
*.key
secrets/

# Editor files
*.swp
*.swo
*~

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# R
.Rhistory
.RData
.Rproj.user/

# Stata
*.log

# LaTeX auxiliary files
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.out
*.toc

# Beamer auxiliary files
*.nav
*.snm
*.vrb

# Compiled PDFs (regenerable from source)
*.pdf

# Reference-corpus PDFs are curated design inputs, not generated outputs
!literature/reference-corpus/**/*.pdf

# Workflow outputs
literature/pdfs/
temp/

# Gold-set build: API response cache + regenerable intermediate JSONs (deliverables live in literature/search-logs/)
source/build/goldset/cache/
source/build/goldset/*.json
